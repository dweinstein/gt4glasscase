				"code" : "| m k n a b |\nm := 48. k := 48. n := 48.\na := Float64Array new: m * k.\n1 to: m * k do: [ :i | a at: i put: (((i * 2654435761) \\\\ 10007) / 10007.0) - 0.5 ].\nb := Float64Array new: k * n.\n1 to: k * n do: [ :i | b at: i put: (((i * 40503) \\\\ 9973) / 9973.0) - 0.5 ].\n(GcKernelBenchmark\n    operation: 'matmul 48x48x48 (naive vs blocked)'\n    naive: [ GcTensorMath matmulA: a rows: m inner: k b: b cols: n ]\n    label: 'naive i-k-j'\n    optimized: [ GcTensorMath matmulBlockedA: a rows: m inner: k b: b cols: n blockSize: 16 ]\n    label: 'blocked (bs=16)') run"
